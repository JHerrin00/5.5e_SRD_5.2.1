      "nested": [
        {
          "type": "javascript",
          "id": "srd521000011",
          "conditioned": false,
          "code": "const labels = [\"Str\", \"Dex\", \"Con\", \"Int\", \"Wis\", \"Cha\"];\nconst stats = Array.isArray(monster.stats) ? monster.stats : [];\nconst mods = Array.isArray(monster.ability_mods) ? monster.ability_mods\n    : stats.map((s) => Math.floor((Number(s) - 10) / 2));\nconst saves = Array.isArray(monster.ability_saves) ? monster.ability_saves : mods;\nconst fmt = (n) => typeof n === \"string\" ? n : (n === null || n === undefined || isNaN(Number(n))) ? \"—\"\n    : (Number(n) >= 0 ? \"+\" + Number(n) : \"−\" + Math.abs(Number(n)));\nconst wrap = document.createElement(\"div\");\nwrap.classList.add(\"srd521-abilities\");\nwrap.style.cssText = \"display:grid;grid-template-columns:repeat(3,1fr);column-gap:0.75em;margin:0.25em 0;\";\nfor (const col of [0, 1, 2]) {\n    const table = document.createElement(\"table\");\n    table.style.cssText = \"width:100%;border-collapse:collapse;margin:0;\";\n    const head = table.insertRow();\n    for (const h of [\"\", \"\", \"MOD\", \"SAVE\"]) {\n        const th = document.createElement(\"th\");\n        th.textContent = h;\n        th.style.cssText = \"font-size:0.65em;font-weight:normal;opacity:0.7;text-align:center;padding:0 0.2em;border:none;background:none;\";\n        head.appendChild(th);\n    }\n    for (const i of [col, col + 3]) {\n        const row = table.insertRow();\n        const values = [labels[i], stats[i] ?? \"—\", fmt(mods[i]), fmt(saves[i])];\n        values.forEach((v, k) => {\n            const td = row.insertCell();\n            td.textContent = String(v);\n            td.style.cssText = \"padding:0.1em 0.2em;border:none;background:none;text-align:\" +\n                (k === 0 ? \"left;font-weight:bold;\" : \"center;\");\n        });\n    }\n    wrap.appendChild(table);\n}\nreturn wrap;"
        }
      ]
